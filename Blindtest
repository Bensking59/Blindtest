          if (remote.teams) {
            gameState.teams = remote.teams;
            if (gameState.status === "lobby") {
              renderSetupTeams();
            }
          }

          if (remote.buzzedTeamId && remote.buzzedTeamId !== gameState.buzzedTeamId && gameState.status === "playing" && !gameState.isAnswered) {
            gameState.buzzedTeamId = remote.buzzedTeamId;
            gameState.answeringTeamId = remote.buzzedTeamId;
            gameState.isPaused = true;
            playSoundEffect("buzz");
            const buzzTeam = gameState.teams.find(t => t.id === remote.buzzedTeamId);
            showToast(`BUZZER de ${buzzTeam ? buzzTeam.name : "une \u00e9quipe"} !`, "info");
            renderGameBoardFromState();
          }

          if (remote.dccMode && remote.dccMode !== gameState.dccMode && gameState.status === "playing") {
            gameState.dccMode = remote.dccMode;
            gameState.qcmOptions = remote.qcmOptions || [];
            renderGameBoardFromState();
          }

          if (remote.isAnswered && !gameState.isAnswered && gameState.status === "playing") {
            gameState.isAnswered = true;
            gameState.lastAnswerSuccess = remote.lastAnswerSuccess;
            gameState.lastPointsEarned = remote.lastPointsEarned;
            clearInterval(timerInterval);
            stopSynthMelody();
            document.getElementById("music-player").pause();
            document.getElementById("visualizer").classList.remove("eq-playing");
            if (remote.lastAnswerSuccess) playSoundEffect("correct");
            else playSoundEffect("wrong");
            renderGameBoardFromState();
          }
        }, () => {});
      } catch (e) {}
    }

