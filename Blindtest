    function ensureAudioContext() {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContext();
      }
      if (audioCtx.state === "suspended") {
        audioCtx.resume();
      }
    }

    function playSoundEffect(type) {
      try {
        ensureAudioContext();
        const now = audioCtx.currentTime;
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        if (type === "correct") {
          osc.type = "triangle";
          osc.frequency.setValueAtTime(523.25, now);
          osc.frequency.setValueAtTime(659.25, now + 0.1);
          osc.frequency.setValueAtTime(783.99, now + 0.2);
          osc.frequency.setValueAtTime(1046.5, now + 0.3);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.6);
          osc.start(now);
          osc.stop(now + 0.6);
        } else if (type === "wrong") {
          osc.type = "sawtooth";
          osc.frequency.setValueAtTime(150, now);
          osc.frequency.linearRampToValueAtTime(95, now + 0.4);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);
          osc.start(now);
          osc.stop(now + 0.45);
        } else if (type === "buzz") {
          osc.type = "square";
          osc.frequency.setValueAtTime(440, now);
          osc.frequency.setValueAtTime(880, now + 0.08);
          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
          osc.start(now);
          osc.stop(now + 0.35);
        } else if (type === "tick") {
          osc.type = "sine";
          osc.frequency.setValueAtTime(880, now);
          gain.gain.setValueAtTime(0.1, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
          osc.start(now);
          osc.stop(now + 0.08);
        }
      } catch (e) {}
    }

    function startSynthMelody(freqs) {
      stopSynthMelody();
      if (!freqs || !freqs.length) return;
      ensureAudioContext();
      let step = 0;
      synthInterval = setInterval(() => {
        if (gameState.isPaused || gameState.isAnswered) return;
        try {
          const now = audioCtx.currentTime;
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = gameState.currentTrack?.cat === "ROCK" ? "sawtooth" : "triangle";
          osc.frequency.setValueAtTime(freqs[step % freqs.length], now);
          gain.gain.setValueAtTime(0.12, now);
          gain.gain.exponentialRampToValueAtTime(0.005, now + 0.28);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now);
          osc.stop(now + 0.3);
          step++;
        } catch (e) {}
      }, 320);
    }

    function stopSynthMelody() {
      if (synthInterval) {
        clearInterval(synthInterval);
        synthInterval = null;
      }
    }

    async function loadAndPlayTrackAudio(track) {
      if (!track) return;
      const player = document.getElementById("music-player");
      const statusText = document.getElementById("audio-status-text");
      const visualizer = document.getElementById("visualizer");

      player.pause();
      player.currentTime = 0;
      stopSynthMelody();

      if (gameState.audioMode === "synth") {
        statusText.textContent = "M\u00e9lodie synth\u00e9tiseur en cours...";
        visualizer.classList.add("eq-playing");
        startSynthMelody(track.freq);
        return;
      }

      statusText.textContent = "Chargement de l'extrait audio...";
      try {
        const cleanTitle = track.title.replace(/\s*\(.*?\)\s*/g, "");
        const cleanArtist = track.artist.replace(/\s*\(.*?\)\s*/g, "");
        const query = encodeURIComponent(`${cleanTitle} ${cleanArtist}`);
        const res = await fetch(`https://itunes.apple.com/search?term=${query}&media=music&limit=1`);
        const data = await res.json();

        if (data.results && data.results.length > 0 && data.results[0].previewUrl) {
          player.src = data.results[0].previewUrl;
          await player.play();
          statusText.textContent = "Extrait musical en cours !";
          visualizer.classList.add("eq-playing");
        } else {
          throw new Error("Aucun apercu");
        }
      } catch (err) {
        statusText.textContent = "Mode M\u00e9lodie TV (Extrait synth\u00e9)";
        visualizer.classList.add("eq-playing");
        startSynthMelody(track.freq);
      }
    }

