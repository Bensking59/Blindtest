<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>BLIND TEST LIVE - Plateau TV Multijoueur</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;800;900&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: radial-gradient(circle at top center, #1e1b4b 0%, #090d16 65%, #02040a 100%);
      color: #f8fafc;
      min-height: 100vh;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }
    h1, h2, h3, .tv-font {
      font-family: 'Montserrat', sans-serif;
    }
    .spotlight {
      position: fixed;
      top: -20%;
      width: 45vw;
      height: 120vh;
      background: linear-gradient(180deg, rgba(99, 102, 241, 0.16) 0%, rgba(236, 72, 153, 0.04) 60%, transparent 100%);
      transform-origin: top center;
      pointer-events: none;
      z-index: 0;
      filter: blur(20px);
    }
    .spotlight-left {
      left: 5%;
      animation: swayLeft 9s ease-in-out infinite alternate;
    }
    .spotlight-right {
      right: 5%;
      background: linear-gradient(180deg, rgba(245, 158, 11, 0.14) 0%, rgba(56, 189, 248, 0.04) 60%, transparent 100%);
      animation: swayRight 11s ease-in-out infinite alternate;
    }
    @keyframes swayLeft {
      0% { transform: rotate(-18deg); }
      100% { transform: rotate(14deg); }
    }
    @keyframes swayRight {
      0% { transform: rotate(18deg); }
      100% { transform: rotate(-14deg); }
    }
    .tv-card {
      background: rgba(15, 23, 42, 0.90);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(148, 163, 184, 0.24);
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    .tv-glow-gold {
      box-shadow: 0 0 22px rgba(245, 158, 11, 0.5), inset 0 0 10px rgba(245, 158, 11, 0.25);
      border-color: #f59e0b !important;
    }
    .eq-bar {
      width: 5px;
      border-radius: 9999px;
      background: linear-gradient(to top, #ec4899, #f59e0b);
      transition: height 0.15s ease;
    }
    .eq-playing .eq-bar:nth-child(1) { animation: eqAnim 0.5s infinite alternate; }
    .eq-playing .eq-bar:nth-child(2) { animation: eqAnim 0.35s infinite alternate 0.1s; }
    .eq-playing .eq-bar:nth-child(3) { animation: eqAnim 0.6s infinite alternate 0.2s; }
    .eq-playing .eq-bar:nth-child(4) { animation: eqAnim 0.4s infinite alternate 0.15s; }
    .eq-playing .eq-bar:nth-child(5) { animation: eqAnim 0.55s infinite alternate 0.05s; }
    @keyframes eqAnim {
      0% { height: 8px; }
      100% { height: 34px; }
    }
    .mic-active {
      animation: pulseMic 1.2s infinite;
    }
    @keyframes pulseMic {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.75); }
      70% { box-shadow: 0 0 0 18px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }
    .buzzer-btn {
      background: radial-gradient(circle at 35% 30%, #ff5e7e 0%, #e11d48 55%, #881337 100%);
      box-shadow: 0 8px 0 #4c0519, 0 15px 25px rgba(225, 29, 72, 0.55), inset 0 3px 6px rgba(255,255,255,0.4);
      transition: transform 0.08s ease, box-shadow 0.08s ease;
    }
    .buzzer-btn:active {
      transform: translateY(6px);
      box-shadow: 0 2px 0 #4c0519, 0 6px 12px rgba(225, 29, 72, 0.4);
    }
    .btn-tv {
      transition: transform 0.1s ease, filter 0.15s ease;
    }
    .btn-tv:active {
      transform: scale(0.96);
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="relative selection:bg-amber-500 selection:text-slate-950">

  <!-- Projecteurs Plateau TV -->
  <div class="spotlight spotlight-left"></div>
  <div class="spotlight spotlight-right"></div>

  <!-- Conteneur Principal Mobile-First -->
  <div id="app" class="relative z-10 max-w-xl mx-auto px-3 py-4 sm:py-6 flex flex-col min-h-screen">

    <!-- EN-TETE TV SHOW -->
    <header class="flex items-center justify-between mb-4 bg-slate-900/95 border border-slate-700/70 rounded-2xl px-3.5 py-2.5 shadow-lg">
      <div class="flex items-center gap-2.5">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 via-orange-500 to-pink-600 flex items-center justify-center shadow-md text-slate-950">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-sm sm:text-base font-black tracking-wider bg-gradient-to-r from-amber-300 via-white to-cyan-300 bg-clip-text text-transparent leading-tight">
            BLIND TEST LIVE
          </h1>
          <p class="text-[11px] text-slate-400 font-medium">Rock USA &bull; Films &bull; S&eacute;ries (<span id="catalog-count">1000</span>)</p>
        </div>
      </div>

      <div class="flex items-center gap-1.5">
        <button id="room-badge" onclick="copyRoomCode()" title="Copier le code du salon" class="hidden px-2.5 py-1.5 rounded-xl bg-indigo-950 border border-cyan-400/60 text-cyan-300 text-xs font-black tracking-widest flex items-center gap-1.5">
          <span id="room-code-text">----</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
        </button>
        <span id="role-badge" class="hidden px-2 py-1 rounded-lg bg-amber-500/20 border border-amber-400/50 text-amber-300 text-[10px] font-black uppercase">
          H&Ocirc;TE
        </span>
        <button onclick="resetToHome()" title="Accueil" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1h3a1 1 0 001-1V10"/></svg>
        </button>
      </div>
    </header>

    <!-- ZONE DE NOTIFICATION -->
    <div id="toast-box" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 w-[92%] max-w-md px-4 py-3 rounded-2xl shadow-2xl border text-sm font-bold text-center transition-all duration-300"></div>

    <!-- ========================================== -->
    <!-- ECRAN 1 : ACCUEIL & CONNEXION MULTIJOUEUR  -->
    <!-- ========================================== -->
    <section id="screen-home" class="space-y-4 flex-1 flex flex-col justify-between">
      <div class="space-y-4">
        <!-- Banniere Jeu TV -->
        <div class="tv-card rounded-3xl p-4 sm:p-5 text-center relative overflow-hidden">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 text-[11px] font-extrabold uppercase tracking-widest mb-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Multijoueur en ligne synchronis&eacute;
          </div>
          <h2 class="text-xl sm:text-2xl font-black text-white mb-1.5">
            Connectez vos T&eacute;l&eacute;phones !
          </h2>
          <p class="text-xs text-slate-300 leading-relaxed">
            <strong>1 H&ocirc;te (Ma&icirc;tre du jeu)</strong> diffuse la musique et pilote le plateau, pendant que les <strong>&Eacute;quipes</strong> buzzent et r&eacute;pondent depuis leur propre t&eacute;l&eacute;phone !
          </p>
        </div>

        <!-- Choix du Role : Hote Online / Rejoindre Salon / Local -->
        <div class="tv-card rounded-3xl p-4 space-y-3">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-cyan-400 flex items-center justify-between">
            <span>1. Choisissez votre r&ocirc;le</span>
            <span id="cloud-status-pill" class="text-[10px] px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-bold">Connexion Cloud...</span>
          </h3>

          <div class="grid grid-cols-2 gap-2.5">
            <button id="btn-mode-host" onclick="selectConnectionMode('host')" class="btn-tv p-3.5 rounded-2xl border-2 border-cyan-400 bg-cyan-500/15 text-left transition">
              <div class="font-extrabold text-sm text-white flex items-center justify-between">
                <span>Cr&eacute;er Salon</span>
                <svg class="w-4 h-4 text-cyan-300" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
              <p class="text-[11px] text-slate-300 mt-1">H&ocirc;te / Ma&icirc;tre du jeu (En ligne)</p>
            </button>

            <button id="btn-mode-local" onclick="selectConnectionMode('local')" class="btn-tv p-3.5 rounded-2xl border border-slate-700 bg-slate-800/60 hover:border-amber-400 text-left transition">
              <div class="font-extrabold text-sm text-white flex items-center justify-between">
                <span>1 T&eacute;l&eacute;phone</span>
                <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18"/></svg>
              </div>
              <p class="text-[11px] text-slate-300 mt-1">Mode local sans internet</p>
            </button>
          </div>

          <!-- Encart Code du Salon genere pour l'Hote -->
          <div id="host-room-banner" class="p-3.5 rounded-2xl bg-gradient-to-r from-indigo-950 to-slate-900 border border-cyan-500/50 flex items-center justify-between">
            <div>
              <div class="text-[11px] font-bold text-cyan-300 uppercase">Code de votre Salon TV :</div>
              <div id="host-generated-code" class="text-2xl font-black tracking-[0.25em] text-white mt-0.5">----</div>
            </div>
            <button onclick="copyRoomCode()" class="btn-tv px-3.5 py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-black text-xs uppercase shadow flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
              <span>Copier</span>
            </button>
          </div>

          <!-- Rejoindre un salon existant (Mode Joueur) -->
          <div class="pt-3 border-t border-slate-800 space-y-2">
            <label class="block text-xs font-extrabold text-amber-300">Joueur : Rejoindre une partie existante</label>
            <div class="flex gap-2">
              <input id="join-code-input" type="text" maxlength="4" placeholder="CODE" class="w-24 uppercase text-center font-black tracking-widest bg-slate-950 border border-slate-700 rounded-xl px-2 py-2.5 text-white text-sm focus:outline-none focus:border-amber-400" />
              <input id="join-team-input" type="text" placeholder="Nom de votre &eacute;quipe" class="flex-1 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-white text-sm focus:outline-none focus:border-amber-400" />
              <button onclick="joinMultiplayerRoom()" class="btn-tv px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-orange-500 font-black text-xs uppercase tracking-wider text-slate-950 shadow-lg">
                Entrer
              </button>
            </div>
          </div>
        </div>

        <!-- Gestion des Equipes -->
        <div id="setup-teams-panel" class="tv-card rounded-3xl p-4 space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-amber-400">
              2. &Eacute;quipes connect&eacute;es / inscrites
            </h3>
            <span id="team-count-label" class="text-xs text-slate-400 font-semibold">2 &eacute;quipes</span>
          </div>

          <div id="teams-setup-list" class="space-y-2"></div>

          <div class="flex gap-2 pt-1">
            <input id="new-team-name" type="text" placeholder="Ajouter une &eacute;quipe manuellement..." class="flex-1 bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-400" />
            <button onclick="addTeam()" class="btn-tv px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-amber-300 font-extrabold text-sm">
              + Ajouter
            </button>
          </div>
        </div>

        <!-- Parametres de la Partie -->
        <div id="setup-options-panel" class="tv-card rounded-3xl p-4 space-y-3">
          <h3 class="text-xs font-extrabold uppercase tracking-wider text-pink-400">
            3. Param&egrave;tres du Show TV
          </h3>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Th&egrave;me Musical</label>
              <select id="category-select" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-xs font-bold text-white focus:outline-none focus:border-pink-400">
                <option value="ALL">Tout (Rock USA + Films/S&eacute;ries)</option>
                <option value="ROCK">100% Rock USA</option>
                <option value="SCREEN">100% S&eacute;ries &amp; Films</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Chrono par titre</label>
              <select id="timer-select" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-xs font-bold text-white focus:outline-none focus:border-pink-400">
                <option value="15">15 secondes</option>
                <option value="25" selected>25 secondes</option>
                <option value="35">35 secondes</option>
              </select>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Titres par manche</label>
              <select id="questions-per-round-select" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-xs font-bold text-white focus:outline-none focus:border-pink-400">
                <option value="5" selected>5 titres / manche</option>
                <option value="8">8 titres / manche</option>
                <option value="10">10 titres / manche</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-slate-400 mb-1">Diffusion Audio</label>
              <select id="audio-mode-select" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2.5 text-xs font-bold text-white focus:outline-none focus:border-pink-400">
                <option value="itunes" selected>Extraits R&eacute;els + Synth&eacute;</option>
                <option value="synth">Mode Synth&eacute;tiseur</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- Bouton Lancer le Show -->
      <button id="btn-start-game" onclick="startGame()" class="btn-tv w-full py-4 rounded-2xl bg-gradient-to-r from-amber-400 via-orange-500 to-pink-600 text-slate-950 font-black text-base sm:text-lg uppercase tracking-wider shadow-xl mt-4">
        Lancer l'&Eacute;mission !
      </button>
    </section>

    <!-- ========================================== -->
    <!-- ECRAN 1B : SALLE D'ATTENTE JOUEUR (GUEST)  -->
    <!-- ========================================== -->
    <section id="screen-guest-lobby" class="hidden tv-card rounded-3xl p-6 text-center space-y-5 my-auto">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-cyan-500/20 border-2 border-cyan-400 flex items-center justify-center text-cyan-300 animate-bounce">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="12" y1="18" x2="12" y2="18"/></svg>
      </div>
      <div>
        <span class="px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400 text-emerald-300 text-xs font-black uppercase">
          Connect&eacute; au Salon <span id="lobby-room-code">----</span>
        </span>
        <h2 class="text-2xl font-black text-white mt-3">
          &Eacute;quipe : <span id="lobby-team-name" class="text-amber-400">...</span>
        </h2>
        <p class="text-xs text-slate-300 mt-1">
          En attente que le Ma&icirc;tre du jeu lance la premi&egrave;re manche...
        </p>
      </div>

      <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-3 text-left space-y-2">
        <div class="text-[11px] font-extrabold text-slate-400 uppercase">&Eacute;quipes dans le salon :</div>
        <div id="lobby-teams-list" class="flex flex-wrap gap-2"></div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- ECRAN 2 : PLATEAU DE JEU                   -->
    <!-- ========================================== -->
    <section id="screen-game" class="hidden space-y-3 flex-1 flex flex-col">

      <!-- Tableau des Scores en Direct -->
      <div id="scoreboard-bar" class="flex gap-2 overflow-x-auto pb-1 no-scrollbar"></div>

      <!-- Bandeau de Manche & Progression -->
      <div class="tv-card rounded-2xl px-4 py-2.5 flex items-center justify-between">
        <div>
          <span id="round-badge" class="text-[11px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-md bg-pink-600 text-white">
            MANCHE 1
          </span>
          <h2 id="round-title" class="text-sm sm:text-base font-black text-white mt-0.5">
            Duo, Carr&eacute; ou Cash
          </h2>
        </div>
        <div class="text-right">
          <div class="text-xs font-extrabold text-amber-400">
            Titre <span id="q-current">1</span> / <span id="q-total">5</span>
          </div>
          <div id="category-pill" class="text-[10px] font-bold text-slate-400 uppercase">
            Rock USA
          </div>
        </div>
      </div>

      <!-- Lecteur Audio, Chrono & Controles Play/Pause -->
      <div class="tv-card rounded-3xl p-4 space-y-3 relative overflow-hidden">
        <div class="w-full h-2.5 bg-slate-800 rounded-full overflow-hidden">
          <div id="timer-bar" class="h-full bg-gradient-to-r from-emerald-400 via-amber-400 to-rose-500 transition-all duration-200" style="width: 100%;"></div>
        </div>

        <div class="flex items-center justify-between gap-2">
          <!-- Boutons Play / Pause -->
          <div class="flex items-center gap-2">
            <button id="btn-play" onclick="resumeGameTimerAndAudio()" class="btn-tv w-11 h-11 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 flex items-center justify-center shadow-lg" title="Lecture">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <button id="btn-pause" onclick="pauseGameTimerAndAudio()" class="btn-tv w-11 h-11 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 flex items-center justify-center shadow-lg" title="Pause">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
          </div>

          <!-- Equalizer Visuel & Statut Audio -->
          <div class="flex-1 flex flex-col items-center justify-center">
            <div id="visualizer" class="flex items-end justify-center gap-1.5 h-8 mb-1">
              <div class="eq-bar h-2"></div>
              <div class="eq-bar h-2"></div>
              <div class="eq-bar h-2"></div>
              <div class="eq-bar h-2"></div>
              <div class="eq-bar h-2"></div>
            </div>
            <span id="audio-status-text" class="text-[11px] font-bold text-cyan-300 text-center line-clamp-1">
              Pr&ecirc;t &agrave; lancer l'extrait...
            </span>
          </div>

          <!-- Affichage Chrono Numerique -->
          <div class="px-3 py-1.5 rounded-2xl bg-slate-950 border-2 border-slate-700 flex flex-col items-center justify-center min-w-[56px]">
            <span id="timer-seconds" class="text-xl font-black text-white leading-none">25</span>
            <span class="text-[9px] font-bold text-slate-400 uppercase">sec</span>
          </div>
        </div>

        <!-- Indice contextuel -->
        <div class="bg-slate-950/80 border border-slate-800 rounded-2xl p-2.5 text-center">
          <p id="clue-text" class="text-xs sm:text-sm font-semibold text-slate-200">
            &Eacute;coutez l'extrait et r&eacute;pondez !
          </p>
        </div>
      </div>

      <!-- GROS BUZZER MULTIJOUEUR (POUR LES JOUEURS) -->
      <div id="guest-buzzer-zone" class="hidden tv-card rounded-3xl p-4 text-center space-y-2 border-2 border-rose-500/60">
        <p class="text-xs font-extrabold text-rose-300 uppercase tracking-wider">
          Vous avez reconnu le morceau ?
        </p>
        <button onclick="pressOnlineBuzzer()" class="buzzer-btn w-full py-5 rounded-2xl text-white font-black text-xl uppercase tracking-widest">
          BUZZER !
        </button>
        <p class="text-[11px] text-slate-400">Appuyez vite pour prendre la main et bloquer le chrono !</p>
      </div>

      <!-- BANDEAU D'ALERTE BUZZER EN DIRECT -->
      <div id="buzzed-banner" class="hidden bg-gradient-to-r from-rose-600 via-pink-600 to-amber-500 rounded-2xl p-3 text-center shadow-lg animate-pulse">
        <div class="text-xs font-black uppercase tracking-widest text-white">
          BUZZER ACTIV&Eacute; PAR :
        </div>
        <div id="buzzed-team-name" class="text-lg font-black text-slate-950">
          &Eacute;QUIPE
        </div>
      </div>

      <!-- SELECTEUR D'EQUIPE ACTIVE (POUR L'HOTE / LOCAL) -->
      <div id="active-team-selector" class="bg-slate-900/90 border border-slate-700/80 rounded-2xl p-2.5 flex items-center justify-between gap-2">
