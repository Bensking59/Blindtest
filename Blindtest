    // =========================================================================
    // 7. DEROULEMENT DES MANCHES & QUESTIONS
    // =========================================================================
    window.startGame = function() {
      if (gameState.teams.length === 0) {
        showToast("Ajoutez au moins une \u00e9quipe !", "error");
        return;
      }

      gameState.status = "playing";
      gameState.category = document.getElementById("category-select").value;
      gameState.timerDuration = parseInt(document.getElementById("timer-select").value, 10);
      gameState.questionsPerRound = parseInt(document.getElementById("questions-per-round-select").value, 10);
      gameState.audioMode = document.getElementById("audio-mode-select").value;
      gameState.round = 1;
      gameState.teams.forEach(t => t.score = 0);
      gameState.answeringTeamId = gameState.teams[0].id;

      if (gameState.connectionMode === "host") {
        const roomBadge = document.getElementById("room-badge");
        document.getElementById("room-code-text").textContent = gameState.roomCode;
        roomBadge.classList.remove("hidden");

        const roleBadge = document.getElementById("role-badge");
        roleBadge.textContent = "H\u00d4TE";
        roleBadge.classList.remove("hidden");
      }

      prepareRound(1);
      showScreen("screen-game");
    };

    function prepareRound(roundNumber) {
      gameState.status = "playing";
      gameState.round = roundNumber;
      gameState.questionIndex = 0;

      let pool = FULL_CATALOG;
      if (gameState.category === "ROCK") {
        pool = FULL_CATALOG.filter(t => t.cat === "ROCK");
      } else if (gameState.category === "SCREEN") {
        pool = FULL_CATALOG.filter(t => t.cat === "SCREEN");
      }

      const shuffled = [...pool].sort(() => Math.random() - 0.5);
      gameState.roundTracks = shuffled.slice(0, gameState.questionsPerRound);

      loadQuestion(0);
    }

    function loadQuestion(index) {
      gameState.questionIndex = index;
      gameState.currentTrack = gameState.roundTracks[index];
      gameState.dccMode = null;
      gameState.qcmOptions = [];
      gameState.timeLeft = gameState.timerDuration;
      gameState.isPaused = false;
      gameState.isAnswered = false;
      gameState.buzzedTeamId = null;
      gameState.lastAnswerSuccess = false;
      gameState.lastPointsEarned = 0;

      const teamIdx = index % gameState.teams.length;
      gameState.answeringTeamId = gameState.teams[teamIdx].id;

      renderGameBoardFromState();
      loadAndPlayTrackAudio(gameState.currentTrack);
      startQuestionTimer();
      syncRoomToFirebase();
    }

    function renderGameBoardFromState() {
      const track = gameState.currentTrack;
      if (!track) return;

      const isGuest = gameState.connectionMode === "guest";
      const isMyTurn = !isGuest || (gameState.answeringTeamId === gameState.myGuestTeamId);

      // 1. Scoreboard
      const sb = document.getElementById("scoreboard-bar");
      sb.innerHTML = "";
      gameState.teams.forEach(team => {
        const col = TEAM_COLORS[team.colorIdx % TEAM_COLORS.length];
        const isActive = team.id === gameState.answeringTeamId;
        const card = document.createElement("div");
        card.className = `shrink-0 min-w-[125px] px-3 py-2 rounded-2xl border ${isActive ? col.border + " tv-glow-gold" : "border-slate-800"} bg-slate-900/90 flex items-center justify-between gap-2`;
        card.innerHTML = `
          <div>
            <div class="text-[11px] font-extrabold ${col.text} truncate max-w-[85px]">${team.name}</div>
            <div class="text-[10px] text-slate-400">${isActive ? "\u00c0 vous" : "En attente"}</div>
          </div>
          <div class="text-lg font-black text-white">${team.score}</div>
        `;
        sb.appendChild(card);
      });

      const activeTeamSelector = document.getElementById("active-team-selector");
      if (isGuest) {
        activeTeamSelector.classList.add("hidden");
      } else {
        activeTeamSelector.classList.remove("hidden");
        const teamSelect = document.getElementById("answering-team-select");
        teamSelect.innerHTML = gameState.teams.map(t =>
          `<option value="${t.id}" ${t.id === gameState.answeringTeamId ? "selected" : ""}>${t.name} (${t.score} pts)</option>`
        ).join("");
      }

      // 2. En-tete de manche
      document.getElementById("round-badge").textContent = `MANCHE ${gameState.round}`;
      document.getElementById("round-title").textContent = gameState.round === 1 ? "Duo, Carr\u00e9 ou Cash" : "Saisie Libre & Voix (Cash)";
      document.getElementById("q-current").textContent = gameState.questionIndex + 1;
      document.getElementById("q-total").textContent = gameState.questionsPerRound;
      document.getElementById("category-pill").textContent = track.cat === "ROCK" ? "Rock USA" : "Film / S\u00e9rie";

      // 3. Indice & Chrono
      document.getElementById("clue-text").textContent = `Indice : ${track.clue}`;
      updateTimerUI();

      // 4. Gestion Buzzer Online
      const buzzerZone = document.getElementById("guest-buzzer-zone");
      const buzzedBanner = document.getElementById("buzzed-banner");

      if (gameState.buzzedTeamId && !gameState.isAnswered) {
        const bTeam = gameState.teams.find(t => t.id === gameState.buzzedTeamId);
        document.getElementById("buzzed-team-name").textContent = bTeam ? bTeam.name : "UNE \u00c9QUIPE";
        buzzedBanner.classList.remove("hidden");
        buzzerZone.classList.add("hidden");
      } else {
        buzzedBanner.classList.add("hidden");
        if (isGuest && !gameState.isAnswered && !isMyTurn) {
          buzzerZone.classList.remove("hidden");
        } else {
          buzzerZone.classList.add("hidden");
        }
      }

      // 5. Affichage des controles de reponse
      const r1Controls = document.getElementById("round1-controls");
      const dccPanel = document.getElementById("dcc-choice-panel");
      const qcmGrid = document.getElementById("qcm-options-grid");
      const freePanel = document.getElementById("free-input-panel");
      const waitingPanel = document.getElementById("waiting-other-team-panel");
      const revealPanel = document.getElementById("reveal-panel");

      if (gameState.isAnswered) {
        r1Controls.classList.add("hidden");
        freePanel.classList.add("hidden");
        waitingPanel.classList.add("hidden");
        revealPanel.classList.remove("hidden");

        const badge = document.getElementById("reveal-badge");
        revealPanel.classList.remove("tv-glow-gold", "border-rose-500");
        if (gameState.lastAnswerSuccess) {
          revealPanel.classList.add("tv-glow-gold");
          badge.className = "inline-block px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400";
          badge.textContent = `BONNE R\u00c9PONSE ! +${gameState.lastPointsEarned} PT${gameState.lastPointsEarned > 1 ? "S" : ""}`;
        } else {
          revealPanel.classList.add("border-rose-500");
          badge.className = "inline-block px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-400";
          badge.textContent = "DOMMAGE ! LA R\u00c9PONSE \u00c9TAIT :";
        }
        document.getElementById("reveal-title").textContent = track.title;
        document.getElementById("reveal-artist").textContent = track.artist;
        document.getElementById("reveal-year").textContent = `Sortie : ${track.year} \u2022 ${track.clue}`;

        if (isGuest) {
          document.getElementById("btn-next-question").classList.add("hidden");
          document.getElementById("guest-wait-next-msg").classList.remove("hidden");
        } else {
          document.getElementById("btn-next-question").classList.remove("hidden");
          document.getElementById("guest-wait-next-msg").classList.add("hidden");
        }
        return;
      }

      revealPanel.classList.add("hidden");

      if (isGuest && !isMyTurn) {
        r1Controls.classList.add("hidden");
        freePanel.classList.add("hidden");
        waitingPanel.classList.remove("hidden");
        const activeT = gameState.teams.find(t => t.id === gameState.answeringTeamId);
        document.getElementById("waiting-team-name").textContent = activeT ? activeT.name : "l'\u00e9quipe adverse";
        return;
      }

      waitingPanel.classList.add("hidden");

      if (gameState.round === 1) {
        r1Controls.classList.remove("hidden");
        if (!gameState.dccMode) {
          dccPanel.classList.remove("hidden");
          qcmGrid.classList.add("hidden");
          freePanel.classList.add("hidden");
        } else if (gameState.dccMode === "duo" || gameState.dccMode === "carre") {
          dccPanel.classList.add("hidden");
          qcmGrid.classList.remove("hidden");
          qcmGrid.classList.add("grid");
          freePanel.classList.add("hidden");
          renderQCMButtons();
        } else if (gameState.dccMode === "cash") {
          dccPanel.classList.add("hidden");
          qcmGrid.classList.add("hidden");
          freePanel.classList.remove("hidden");
          document.getElementById("free-input-label").textContent = "Mode CASH (+5 points)";
        }
      } else {
        r1Controls.classList.add("hidden");
        freePanel.classList.remove("hidden");
        document.getElementById("free-input-label").textContent = "Manche 2 : Saisie Libre ou Vocale (+4 points)";
      }
    }

    window.changeAnsweringTeam = function(teamId) {
      gameState.answeringTeamId = teamId;
      gameState.buzzedTeamId = null;
      renderGameBoardFromState();
      syncRoomToFirebase();
    };

    // =========================================================================
    // 8. CHRONOMETRE & CONTROLES PLAY / PAUSE SYNCHRONISES
    // =========================================================================
    function startQuestionTimer() {
      clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        if (gameState.isPaused || gameState.isAnswered) return;

        gameState.timeLeft -= 1;
        updateTimerUI();

        if (gameState.connectionMode === "host" && gameState.timeLeft % 3 === 0) {
          syncRoomToFirebase();
        }

        if (gameState.timeLeft <= 5 && gameState.timeLeft > 0) {
          playSoundEffect("tick");
        }

        if (gameState.timeLeft <= 0) {
          clearInterval(timerInterval);
          showToast("Temps \u00e9coul\u00e9 !", "error");
          revealAnswer(false);
        }
      }, 1000);
    }

    function updateTimerUI() {
      const secEl = document.getElementById("timer-seconds");
      const barEl = document.getElementById("timer-bar");
      secEl.textContent = Math.max(0, gameState.timeLeft);
      const pct = Math.max(0, (gameState.timeLeft / gameState.timerDuration) * 100);
      barEl.style.width = `${pct}%`;

      if (gameState.timeLeft <= 5) {
        secEl.classList.add("text-rose-500");
      } else {
        secEl.classList.remove("text-rose-500");
      }
    }

    window.pauseGameTimerAndAudio = function() {
      gameState.isPaused = true;
      document.getElementById("music-player").pause();
      document.getElementById("visualizer").classList.remove("eq-playing");
      document.getElementById("audio-status-text").textContent = "Jeu et musique en PAUSE";
      showToast("Jeu mis en pause", "info");
      if (gameState.connectionMode === "host") syncRoomToFirebase();
    };

    window.resumeGameTimerAndAudio = function() {
      if (gameState.isAnswered) return;
      gameState.isPaused = false;
      gameState.buzzedTeamId = null;
      const player = document.getElementById("music-player");
      if (player.src && gameState.audioMode === "itunes") {
        player.play().catch(() => {});
      }
      document.getElementById("visualizer").classList.add("eq-playing");
      document.getElementById("audio-status-text").textContent = "Lecture en cours...";
      renderGameBoardFromState();
      if (gameState.connectionMode === "host") syncRoomToFirebase();
    };

    // =========================================================================
    // 9. DUO / CARRE / CASH & SAISIE LIBRE + RECONNAISSANCE VOCALE
    // =========================================================================
    window.chooseDCC = async function(mode) {
      gameState.dccMode = mode;
      const correct = gameState.currentTrack;

      if (mode === "duo" || mode === "carre") {
        const count = mode === "duo" ? 2 : 4;
        const sameCat = FULL_CATALOG.filter(t => t.cat === correct.cat && t.title !== correct.title);
        const distractors = [...sameCat].sort(() => Math.random() - 0.5).slice(0, count - 1);
        const options = [correct, ...distractors].sort(() => Math.random() - 0.5);
        gameState.qcmOptions = options.map(o => ({
          title: o.title,
          artist: o.artist,
          isCorrect: o.title === correct.title
        }));
      } else {
        document.getElementById("free-answer-input").value = "";
        setTimeout(() => document.getElementById("free-answer-input").focus(), 100);
      }

      renderGameBoardFromState();
      if (gameState.connectionMode === "host") {
        await syncRoomToFirebase();
      } else if (gameState.connectionMode === "guest" && isFirebaseReady && db) {
        const roomRef = doc(db, "artifacts", appId, "public", "data", "rooms", gameState.roomCode);
        await updateDoc(roomRef, { dccMode: mode, qcmOptions: gameState.qcmOptions });
      }
    };

    function renderQCMButtons() {
      const grid = document.getElementById("qcm-options-grid");
      grid.innerHTML = "";
      const letters = ["A", "B", "C", "D"];

      gameState.qcmOptions.forEach((opt, i) => {
        const btn = document.createElement("button");
        btn.className = "btn-tv tv-card rounded-2xl p-3.5 text-left border border-slate-700 hover:border-amber-400 flex items-center gap-3";
        btn.innerHTML = `
          <span class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-600 flex items-center justify-center font-black text-amber-400 text-sm shrink-0">
            ${letters[i]}
          </span>
          <div class="min-w-0 flex-1">
            <div class="font-extrabold text-sm text-white truncate">${opt.title}</div>
            <div class="text-xs text-slate-400 truncate">${opt.artist}</div>
          </div>
        `;
        btn.onclick = () => handleQCMAnswer(opt.isCorrect);
        grid.appendChild(btn);
      });
    }

    function handleQCMAnswer(isCorrect) {
      if (gameState.isAnswered) return;
      const pts = gameState.dccMode === "duo" ? 1 : 3;
      if (isCorrect) {
        awardPointsToActiveTeam(pts);
        revealAnswer(true, pts);
      } else {
        revealAnswer(false, 0);
      }
    }

    function normalizeText(str) {
      return str
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/\(.*?\)/g, "")
        .replace(/[^a-z0-9\s]/g, "")
        .trim();
    }

    function isAnswerMatch(userInput, track) {
      const guess = normalizeText(userInput);
      if (guess.length < 3) return false;

      const cleanTitle = normalizeText(track.title);
      const cleanArtist = normalizeText(track.artist);

      if (cleanTitle.includes(guess) || guess.includes(cleanTitle)) return true;
      if (cleanArtist.includes(guess) || guess.includes(cleanArtist)) return true;

      const guessWords = guess.split(/\s+/).filter(w => w.length >= 4);
      const targetWords = `${cleanTitle} ${cleanArtist}`.split(/\s+/).filter(w => w.length >= 4);
      return guessWords.some(gw => targetWords.some(tw => tw === gw));
    }

    window.submitFreeAnswer = function() {
      if (gameState.isAnswered) return;
      const input = document.getElementById("free-answer-input");
      const val = input.value.trim();
      if (!val) {
        showToast("Saisissez ou dictez une r\u00e9ponse !", "error");
        return;
      }

      const correct = isAnswerMatch(val, gameState.currentTrack);
      const pts = gameState.round === 1 ? 5 : 4;

      if (correct) {
        awardPointsToActiveTeam(pts);
        revealAnswer(true, pts);
      } else {
        playSoundEffect("wrong");
        showToast(`"${val}" ne correspond pas... R\u00e9essayez ou r\u00e9v\u00e9lez !`, "error");
        input.value = "";
      }
    };

    // =========================================================================
    // 10. RECONNAISSANCE VOCALE (WEB SPEECH API)
    // =========================================================================
    window.toggleVoiceRecognition = function() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        showToast("La reconnaissance vocale n'est pas support\u00e9e sur ce navigateur.", "error");
        return;
      }

      if (isListeningVoice && recognition) {
        recognition.stop();
        return;
      }

      recognition = new SpeechRecognition();
      recognition.lang = "en-US";
      recognition.interimResults = true;
      recognition.maxAlternatives = 3;

      const btnVoice = document.getElementById("btn-voice");
      const voiceStatus = document.getElementById("voice-status");
      const inputEl = document.getElementById("free-answer-input");

      recognition.onstart = () => {
        isListeningVoice = true;
        btnVoice.classList.add("mic-active", "bg-red-500");
        voiceStatus.classList.remove("hidden");
        document.getElementById("music-player").volume = 0.15;
      };

      recognition.onresult = (event) => {
        let transcript = "";
        for (let i = event.resultIndex; i < event.results.length; i++) {
          transcript += event.results[i][0].transcript;
        }
        inputEl.value = transcript;

        for (let i = 0; i < event.results[event.results.length - 1].length; i++) {
          const alt = event.results[event.results.length - 1][i].transcript;
          if (isAnswerMatch(alt, gameState.currentTrack)) {
            inputEl.value = alt;
            recognition.stop();
            submitFreeAnswer();
            return;
          }
        }
      };

      recognition.onerror = () => {
        showToast("Micro non d\u00e9tect\u00e9 ou autorisation refus\u00e9e.", "error");
      };

      recognition.onend = () => {
        isListeningVoice = false;
        btnVoice.classList.remove("mic-active", "bg-red-500");
        voiceStatus.classList.add("hidden");
        document.getElementById("music-player").volume = 1.0;
      };

      recognition.start();
    };

    // =========================================================================
    // 11. ATTRIBUTION DES POINTS, REVELATION & CLASSEMENT FINAL
    // =========================================================================
    function awardPointsToActiveTeam(points) {
      const team = gameState.teams.find(t => t.id === gameState.answeringTeamId);
      if (team) {
        team.score += points;
      }
    }

    window.revealAnswer = async function(isSuccess, pointsEarned = 0) {
      gameState.isAnswered = true;
      gameState.lastAnswerSuccess = isSuccess;
      gameState.lastPointsEarned = pointsEarned;
      gameState.buzzedTeamId = null;

      clearInterval(timerInterval);
      stopSynthMelody();
      document.getElementById("music-player").pause();
      document.getElementById("visualizer").classList.remove("eq-playing");

      if (isSuccess) playSoundEffect("correct");
      else playSoundEffect("wrong");

      document.getElementById("free-answer-input").value = "";
      renderGameBoardFromState();

      if (gameState.connectionMode === "host") {
        await syncRoomToFirebase();
      } else if (gameState.connectionMode === "guest" && isFirebaseReady && db) {
        const roomRef = doc(db, "artifacts", appId, "public", "data", "rooms", gameState.roomCode);
        await updateDoc(roomRef, {
          teams: gameState.teams,
          isAnswered: true,
          lastAnswerSuccess: isSuccess,
          lastPointsEarned: pointsEarned,
          buzzedTeamId: null
        });
      }
    };

    window.nextQuestion = function() {
      const nextIdx = gameState.questionIndex + 1;
      if (nextIdx < gameState.questionsPerRound) {
        loadQuestion(nextIdx);
      } else {
        gameState.status = "summary";
        showRoundSummary();
        syncRoomToFirebase();
      }
    };

    function showRoundSummary() {
      showScreen("screen-summary");
      const sorted = [...gameState.teams].sort((a, b) => b.score - a.score);
      const lb = document.getElementById("summary-leaderboard");
      lb.innerHTML = "";

      sorted.forEach((t, idx) => {
        const col = TEAM_COLORS[t.colorIdx % TEAM_COLORS.length];
        const rankLabel = idx === 0 ? "1er" : `${idx + 1}e`;
        const row = document.createElement("div");
        row.className = `flex items-center justify-between p-3.5 rounded-2xl border ${idx === 0 ? "border-amber-400 bg-amber-500/15" : "border-slate-700 bg-slate-900/80"}`;
        row.innerHTML = `
          <div class="flex items-center gap-3">
            <span class="px-2 py-0.5 rounded-lg bg-slate-800 text-xs font-black text-amber-300">${rankLabel}</span>
            <span class="font-black text-base ${col.text}">${t.name}</span>
          </div>
          <span class="text-xl font-black text-white">${t.score} pts</span>
        `;
        lb.appendChild(row);
      });

      const isGuest = gameState.connectionMode === "guest";
      const btnNext = document.getElementById("btn-next-round");
      const guestWaitMsg = document.getElementById("guest-wait-round-msg");

      if (gameState.round === 1) {
        document.getElementById("summary-subtitle").textContent = "FIN DE LA MANCHE 1 (DUO / CARR\u00c9 / CASH)";
        document.getElementById("summary-title").textContent = "Classement Interm\u00e9diaire";
        if (isGuest) {
          btnNext.classList.add("hidden");
          guestWaitMsg.classList.remove("hidden");
        } else {
          btnNext.classList.remove("hidden");
          guestWaitMsg.classList.add("hidden");
          btnNext.textContent = "Manche 2 : Saisie Libre & Voix";
          btnNext.onclick = () => {
            prepareRound(2);
            showScreen("screen-game");
          };
        }
      } else {
        document.getElementById("summary-subtitle").textContent = "FIN DU GRAND BLIND TEST SHOW";
        document.getElementById("summary-title").textContent = `Vainqueur : ${sorted[0].name} !`;
        if (isGuest) {
          btnNext.classList.add("hidden");
          guestWaitMsg.textContent = "Merci d'avoir particip\u00e9 au Blind Test Live !";
          guestWaitMsg.classList.remove("hidden");
        } else {
          btnNext.classList.remove("hidden");
          guestWaitMsg.classList.add("hidden");
          btnNext.textContent = "Rejouer une Nouvelle Partie";
          btnNext.onclick = () => {
            resetToHome();
          };
        }
      }
    }

    renderSetupTeams();
    initFirebase();
  </script>
</body>
</html>
