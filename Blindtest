              `<span class="px-3 py-1 rounded-xl bg-slate-800 border border-slate-700 text-xs font-bold text-white">${t.name}</span>`
            ).join("");
          } else if (gameState.status === "playing") {
            showScreen("screen-game");
            renderGameBoardFromState();

            if (trackChanged && gameState.currentTrack) {
              lastPlayedTrackTitle = gameState.currentTrack.title;
              loadAndPlayTrackAudio(gameState.currentTrack);
            }
            if (gameState.isPaused && !wasPaused) {
              document.getElementById("music-player").pause();
              document.getElementById("visualizer").classList.remove("eq-playing");
            } else if (!gameState.isPaused && wasPaused && !gameState.isAnswered) {
              document.getElementById("music-player").play().catch(() => {});
              document.getElementById("visualizer").classList.add("eq-playing");
            }
            if (gameState.isAnswered) {
              stopSynthMelody();
              document.getElementById("music-player").pause();
              document.getElementById("visualizer").classList.remove("eq-playing");
            }
          } else if (gameState.status === "summary") {
            showRoundSummary();
          }
        }, () => {});
      } catch (e) {
        showToast("Impossible de rejoindre ce salon.", "error");
      }
    };

    window.pressOnlineBuzzer = async function() {
      if (gameState.connectionMode !== "guest" || !gameState.myGuestTeamId) return;
      if (gameState.buzzedTeamId || gameState.isAnswered) return;

      playSoundEffect("buzz");
      gameState.buzzedTeamId = gameState.myGuestTeamId;
      gameState.answeringTeamId = gameState.myGuestTeamId;
      gameState.isPaused = true;
      renderGameBoardFromState();

      if (isFirebaseReady && db && gameState.roomCode) {
        const roomRef = doc(db, "artifacts", appId, "public", "data", "rooms", gameState.roomCode);
        await updateDoc(roomRef, {
          buzzedTeamId: gameState.myGuestTeamId,
          answeringTeamId: gameState.myGuestTeamId,
          isPaused: true
        });
      }
    };

    // =========================================================================
