          timeLeft: gameState.timerDuration,
          isPaused: false,
          isAnswered: false,
          lastAnswerSuccess: false,
          lastPointsEarned: 0,
          updatedAt: Date.now()
        });

        if (roomUnsubscribe) roomUnsubscribe();
        roomUnsubscribe = onSnapshot(roomRef, (docSnap) => {
          if (!docSnap.exists()) return;
